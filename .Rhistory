library(plotly)
library(tseries)
library(forecast)
library(prophet)
# Creación base inicial ----
# Leer archivo inicial
datos_narcotrafico <- readRDS(here('data', 'datos_narcotrafico.rds'))
library(here)
# Creación base inicial ----
# Leer archivo inicial
datos_narcotrafico <- readRDS(here('data', 'datos_narcotrafico.rds'))
